# Copy to .env.local and fill in. Never commit .env.local.

# OpenAI — embeddings (text-embedding-3-small) + chat (classify, Q&A)
OPENAI_API_KEY=

# Supabase — Postgres + pgvector
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# NYC Open Data (Socrata) — OPTIONAL app token for /api/lookup (raises rate limits)
SOCRATA_APP_TOKEN=

# Supabase Postgres connection string — used by scripts/seed.py for bulk loads
# (Project Settings -> Database -> Connection string)
DATABASE_URL=
